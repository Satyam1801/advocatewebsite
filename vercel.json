{
  "buildCommand": "prisma generate && prisma db push && npx tsx prisma/seed.ts || true && next build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "rewrites": [],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}